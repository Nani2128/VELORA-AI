# ============================================================
# VELORA AI — ENVIRONMENT CONFIGURATION
# ============================================================

# Primary Cloud AI Provider (Gemini 3.8 Flash, 3.1 Pro, Imagen 3, Veo)
GEMINI_API_KEY=""

# Fal.ai: High-Speed FLUX.1 [schnell] Image Queue
FAL_KEY=""

# OpenAI: GPT-4o, DALL-E 3 Image Provider
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="dall-e-3"

# Groq: LPU Ultra-Fast Inference Provider
GROQ_API_KEY=""

# DeepSeek: DeepSeek-V3 and DeepSeek-R1 (Reasoning)
DEEPSEEK_API_KEY=""

# xAI Grok: Grok 2 Beta and Grok Imagine Image
XAI_API_KEY=""

# Hugging Face: Dynamic Serverless Inference Provider
HF_TOKEN=""

# OLLAMA: Local Offline / Self-Hosted Fallback Provider
OLLAMA_ENABLED="true"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL=""

# OPENAI_COMPATIBLE: Self-Hosted / Remote Custom Gateway (vLLM, LMStudio, LocalAI)
OPENAI_COMPATIBLE_ENABLED="false"
OPENAI_COMPATIBLE_BASE_URL="http://localhost:8000/v1"
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL="default"

# FLUX: Self-Hosted / Dedicated FLUX.1 Endpoint
FLUX_ENABLED="false"
FLUX_API_URL=""
FLUX_API_KEY=""
FLUX_MODEL="flux-1-schnell"

# STABILITY AI: SDXL & Stable Diffusion 3.5
SD_ENABLED="false"
SD_API_URL=""
SD_API_KEY=""
SD_MODEL="sdxl"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string (production required)
DATABASE_URL="postgresql://user:password@localhost:5432/velora"

# REDIS_URL: Redis connection string
REDIS_URL="redis://localhost:6379/0"

# STORAGE: S3 or local filesystem storage configuration
STORAGE_PROVIDER="local"
STORAGE_BUCKET="velora-assets"
STORAGE_ENDPOINT=""

# APP ENVIRONMENT
NODE_ENV="development"
PORT="3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
